{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@next/next/no-img-element": "off"
  },
  "overrides": [
    {
      "files": [
        "src/hooks/use-call.ts",
        "src/components/moji-picker.tsx"
      ],
      "rules": {
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ]
}
