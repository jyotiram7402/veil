# Copy to .env.local for local dev. In production these live in
# Vercel -> Project -> Settings -> Environment Variables (never commit real values).
# In Vercel, NEXT_PUBLIC_* variables must use type "Config" (not "Secret"),
# and any change needs a redeploy (NEXT_PUBLIC_* values are inlined at build).

# --- Supabase (public, exposed to browser) ---
# Supabase -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase -> Settings -> API -> Legacy API keys -> "anon public" (starts with eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Supabase service role (server only, NEVER expose) ---
# Supabase -> Settings -> API -> Legacy API keys -> "service_role". Used by API
# routes to create users and bypass RLS after their own auth checks.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Internal email domain for the username<->auth.users mapping ---
# Logins use <username>@<this domain> behind the scenes. Any non-routable
# suffix works. Do NOT change after users exist, or nobody can sign in.
INTERNAL_EMAIL_DOMAIN=rooms.local

# --- Admin bootstrap ---
# Only works while the profiles table is empty: POST /api/admin/users with
# header x-admin-token: <this value> creates the first admin.
# Generate a strong random string (e.g. `openssl rand -hex 32`).
ADMIN_BOOTSTRAP_TOKEN=replace-me-with-a-long-random-string

# --- App URL (absolute links such as invites; optional locally) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Call relay: Cloudflare Realtime TURN (server only, NEVER expose) ---
# Calls between two different networks (Wi-Fi and mobile data, for example)
# pass through a relay. Without these two values such calls cannot connect.
# Cloudflare dashboard -> Realtime -> TURN -> create a TURN key. It shows a
# "Turn Token ID" and an "API Token".
# The server trades them for short-lived credentials (src/lib/turn.ts), so the
# key itself never reaches a browser. Check: Settings -> Calls -> Call relay.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
